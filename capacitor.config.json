{
  "appId": "ar.com.fulvo.app",
  "appName": "FULVO",
  "webDir": "dist",
  "backgroundColor": "#0b1220",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0b1220",
      "showSpinner": false
    }
  }
}
