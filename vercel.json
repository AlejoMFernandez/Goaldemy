{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "goaldemy.vercel.app" }],
      "destination": "https://fulvo.com.ar/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/fotmob", "destination": "https://www.fotmob.com/" },
    { "source": "/fotmob/:path*", "destination": "https://www.fotmob.com/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2|png|jpg|jpeg|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
